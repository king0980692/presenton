{
  "name": "nature-organic",
  "ordered": false,
  "slides": [
    {
      "id": "nature-organic:organic-cover",
      "name": "1. Nature Cover",
      "description": "Soft, rounded, nature-inspired cover layout.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bg_hero": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          },
          "report_title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "report_subtitle": {
            "description": "Descriptive text. Max 50 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 350
          }
        },
        "required": [
          "bg_hero",
          "report_title",
          "report_subtitle"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "nature-organic:organic-grid",
      "name": "3. Green Actions",
      "description": "Grid of key environmental actions with icons.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "grid_title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "action_points": {
            "description": "List of bullet points with icons",
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "description": "Bullet title",
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 30
                },
                "description": {
                  "description": "Bullet description",
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 150
                },
                "icon": {
                  "type": "object",
                  "properties": {
                    "__icon_url__": {
                      "description": "Icon URL",
                      "type": "string"
                    },
                    "__icon_query__": {
                      "description": "Icon search query",
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 20
                    }
                  },
                  "required": [
                    "__icon_url__",
                    "__icon_query__"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "title",
                "description"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "grid_title",
          "action_points"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "nature-organic:organic-story",
      "name": "2. Our Story",
      "description": "Layout with circular image and storytelling space.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "story_img": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          },
          "story_title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "story_body": {
            "description": "Descriptive text. Max 200 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 1400
          }
        },
        "required": [
          "story_img",
          "story_title",
          "story_body"
        ],
        "additionalProperties": false
      }
    }
  ]
}