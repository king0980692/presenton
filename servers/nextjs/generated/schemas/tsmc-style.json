{
  "name": "tsmc-style",
  "ordered": true,
  "slides": [
    {
      "id": "tsmc-style:cover",
      "name": "TSMC Cover Page",
      "description": "Professional cover with corporate branding.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "logo": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          },
          "title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "subtitle": {
            "description": "Descriptive text. Max 20 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 140
          },
          "hero_bg": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          },
          "year": {
            "description": "Descriptive text. Max 2 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 14
          }
        },
        "required": [
          "logo",
          "title",
          "subtitle",
          "hero_bg",
          "year"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "tsmc-style:toc",
      "name": "Table of Contents",
      "description": "Clean list layout for report sections.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "page_title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "chapters": {
            "description": "List of bullet points",
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "description": "Bullet title",
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 30
                },
                "description": {
                  "description": "Bullet description",
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 150
                }
              },
              "required": [
                "title",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "side_img": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "page_title",
          "chapters",
          "side_img"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "tsmc-style:tsmc-metrics-chart",
      "name": "Tech Sustainability Report",
      "description": "High-tech style layout focusing on key performance indicators and data visualization.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "subtitle": {
            "description": "Descriptive text. Max 30 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 210
          },
          "kpi_metrics": {
            "description": "Key metrics to display",
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "description": "Metric value",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10
                },
                "label": {
                  "description": "Metric label",
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 20
                },
                "description": {
                  "description": "Metric description",
                  "type": "string",
                  "maxLength": 100
                }
              },
              "required": [
                "value",
                "label",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "performance_chart": {
            "description": "Chart configuration",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "bar",
                  "line"
                ]
              },
              "data": {
                "minItems": 2,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "description": "Data label",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20
                    },
                    "value": {
                      "description": "Data value",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "data"
            ],
            "additionalProperties": false
          },
          "sidebar_bg": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "subtitle",
          "kpi_metrics",
          "performance_chart",
          "sidebar_bg"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "tsmc-style:metrics",
      "name": "Key Performance Indicators",
      "description": "Data-heavy layout for showing ESG metrics.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "chart_1": {
            "description": "Chart configuration",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "bar",
                  "line"
                ]
              },
              "data": {
                "minItems": 2,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "description": "Data label",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20
                    },
                    "value": {
                      "description": "Data value",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "data"
            ],
            "additionalProperties": false
          },
          "chart_2": {
            "description": "Chart configuration",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "pie",
                  "bar"
                ]
              },
              "data": {
                "minItems": 2,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "description": "Data label",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20
                    },
                    "value": {
                      "description": "Data value",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "data"
            ],
            "additionalProperties": false
          },
          "data_table": {
            "description": "Table data with headers and rows",
            "type": "object",
            "properties": {
              "headers": {
                "minItems": 2,
                "maxItems": 5,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "headers",
              "rows"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "chart_1",
          "chart_2",
          "data_table"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "tsmc-style:split-content",
      "name": "Process Description",
      "description": "Image and text side-by-side for technical details.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "body": {
            "description": "Descriptive text. Max 150 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 1050
          },
          "diagram": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "body",
          "diagram"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "tsmc-style:back-cover",
      "name": "Back Cover",
      "description": "Simple closing page with contact information.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bg": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          },
          "closing": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "contact": {
            "description": "Descriptive text. Max 30 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 210
          }
        },
        "required": [
          "bg",
          "closing",
          "contact"
        ],
        "additionalProperties": false
      }
    }
  ]
}