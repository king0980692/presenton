{
  "name": "custom",
  "ordered": false,
  "slides": [
    {
      "id": "custom:data-table",
      "name": "Data Table Slide",
      "description": "A single column slide with title, description, and a data table",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "description": "Main heading text. Max 6 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 42
          },
          "description": {
            "description": "Descriptive text. Max 30 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 210
          },
          "data": {
            "description": "Table data with headers and rows",
            "type": "object",
            "properties": {
              "headers": {
                "minItems": 2,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "minItems": 1,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "headers",
              "rows"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "description",
          "data"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "custom:hero-overlay",
      "name": "Hero Image Overlay",
      "description": "Full-screen hero image with overlaid title and subtitle text. Great for intro or section divider slides.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bg": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          },
          "title": {
            "description": "Main heading text. Max 8 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 56
          },
          "subtitle": {
            "description": "Descriptive text. Max 20 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 140
          },
          "logo": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "bg",
          "title",
          "subtitle",
          "logo"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "custom:image-left-text-right",
      "name": "Image Left with Title and Text",
      "description": "Left half is a full-height image, right half has title, subtitle, and body text. Great for feature introduction or storytelling slides.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "image": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          },
          "title": {
            "description": "Main heading text. Max 8 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 56
          },
          "subtitle": {
            "description": "Descriptive text. Max 15 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 105
          },
          "body": {
            "description": "Descriptive text. Max 80 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 560
          }
        },
        "required": [
          "image",
          "title",
          "subtitle",
          "body"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "custom:metrics-with-chart",
      "name": "Metrics with Chart",
      "description": "A slide showing key metrics on the left and a chart visualization on the right",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "description": "Main heading text. Max 6 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 42
          },
          "description": {
            "description": "Descriptive text. Max 30 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 210
          },
          "metrics": {
            "description": "Key metrics to display",
            "minItems": 1,
            "maxItems": 3,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "value": {
                  "description": "Metric value",
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10
                },
                "label": {
                  "description": "Metric label",
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 20
                },
                "description": {
                  "description": "Metric description",
                  "type": "string",
                  "maxLength": 100
                }
              },
              "required": [
                "value",
                "label",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "chart": {
            "description": "Chart configuration",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "bar",
                  "line",
                  "pie"
                ]
              },
              "data": {
                "minItems": 2,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "description": "Data label",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20
                    },
                    "value": {
                      "description": "Data value",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "data"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "description",
          "metrics",
          "chart"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "custom:title-bullets-image",
      "name": "Title with Bullets and Image",
      "description": "A two-column slide with title, bullet points on the left and an image on the right",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "title": {
            "description": "Main heading text. Max 8 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 56
          },
          "subtitle": {
            "description": "Descriptive text. Max 25 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 175
          },
          "features": {
            "description": "List of bullet points with icons",
            "minItems": 1,
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "description": "Bullet title",
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 30
                },
                "description": {
                  "description": "Bullet description",
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 150
                },
                "icon": {
                  "type": "object",
                  "properties": {
                    "__icon_url__": {
                      "description": "Icon URL",
                      "type": "string"
                    },
                    "__icon_query__": {
                      "description": "Icon search query",
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 20
                    }
                  },
                  "required": [
                    "__icon_url__",
                    "__icon_query__"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "title",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "image": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "title",
          "subtitle",
          "features",
          "image"
        ],
        "additionalProperties": false
      }
    }
  ]
}