{
  "name": "finance-trust",
  "ordered": false,
  "slides": [
    {
      "id": "finance-trust:annual-highlight",
      "name": "Financial Trust Highlight",
      "description": "A warm, trustworthy layout for financial and insurance reports.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "header_image": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          },
          "white_overlay": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          },
          "page_title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "intro_text": {
            "description": "Descriptive text. Max 50 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 350
          },
          "highlights": {
            "description": "List of bullet points with icons",
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "description": "Bullet title",
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 30
                },
                "description": {
                  "description": "Bullet description",
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 150
                },
                "icon": {
                  "type": "object",
                  "properties": {
                    "__icon_url__": {
                      "description": "Icon URL",
                      "type": "string"
                    },
                    "__icon_query__": {
                      "description": "Icon search query",
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 20
                    }
                  },
                  "required": [
                    "__icon_url__",
                    "__icon_query__"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "title",
                "description"
              ],
              "additionalProperties": false
            }
          },
          "financial_data": {
            "description": "Table data with headers and rows",
            "type": "object",
            "properties": {
              "headers": {
                "minItems": 2,
                "maxItems": 2,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "minItems": 1,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "headers",
              "rows"
            ],
            "additionalProperties": false
          },
          "orange_stripe": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "header_image",
          "white_overlay",
          "page_title",
          "intro_text",
          "highlights",
          "financial_data",
          "orange_stripe"
        ],
        "additionalProperties": false
      }
    }
  ]
}