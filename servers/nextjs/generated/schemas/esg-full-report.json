      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "matrix_title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "materiality_chart": {
            "description": "Chart configuration",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "scatter"
                ]
              },
              "data": {
                "minItems": 2,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "label": {
                      "description": "Data label",
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 20
                    },
                    "value": {
                      "description": "Data value",
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  },
                  "required": [
                    "label",
                    "value"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "type",
              "data"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "matrix_title",
          "materiality_chart"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "esg-full-report:social-impact",
      "name": "4. Social Impact",
      "description": "Layout for showcasing social initiatives with imagery.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "social_title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "event_photo": {
            "description": "Image with URL and prompt",
            "type": "object",
            "properties": {
              "__image_url__": {
                "description": "Image URL",
                "type": "string",
                "format": "uri"
              },
              "__image_prompt__": {
                "description": "Image generation prompt",
                "type": "string",
                "minLength": 10,
                "maxLength": 100
              }
            },
            "required": [
              "__image_url__",
              "__image_prompt__"
            ],
            "additionalProperties": false
          },
          "initiatives": {
            "description": "List of bullet points",
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "description": "Bullet title",
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 30
                },
                "description": {
                  "description": "Bullet description",
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 150
                }
              },
              "required": [
                "title",
                "description"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "social_title",
          "event_photo",
          "initiatives"
        ],
        "additionalProperties": false
      }
    },
    {
      "id": "esg-full-report:toc",
      "name": "0. Table of Contents",
      "description": "Agenda slide listing report sections.",
      "json_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "toc_title": {
            "description": "Main heading text. Max 10 words",
            "type": "string",
            "minLength": 5,
            "maxLength": 70
          },
          "toc_subtitle": {
            "description": "Descriptive text. Max 50 words",
            "type": "string",
            "minLength": 10,
            "maxLength": 350
          },
          "chapters": {
            "description": "List of bullet points with icons",
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "description": "Bullet title",
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 30
                },
                "description": {
                  "description": "Bullet description",
                  "type": "string",
                  "minLength": 10,
                  "maxLength": 150
                },
                "icon": {
                  "type": "object",
                  "properties": {
                    "__icon_url__": {
                      "description": "Icon URL",
                      "type": "string"
                    },
                    "__icon_query__": {
                      "description": "Icon search query",
                      "type": "string",
                      "minLength": 2,
                      "maxLength": 20
                    }
                  },
                  "required": [
                    "__icon_url__",
                    "__icon_query__"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "title",
                "description"
              ],
              "additionalProperties": false
            }
          }
