{
    "templateName": "tsmc-style",
    "layoutId": "split-content",
    "layoutName": "Process Description",
    "layoutDescription": "Image and text side-by-side for technical details.",
    "structure": {
        "type": "absolute",
        "elements": [
            {
                "type": "heading",
                "field": "title",
                "bounds": [
                    5,
                    5,
                    90,
                    10
                ],
                "align": "left",
                "level": 2,
                "defaultValue": "Advanced Manufacturing"
            },
            {
                "type": "text",
                "field": "body",
                "bounds": [
                    5,
                    20,
                    45,
                    70
                ],
                "maxWords": 150,
                "defaultValue": "TSMC leads the world in advanced process technology..."
            },
            {
                "type": "image",
                "field": "diagram",
                "bounds": [
                    55,
                    20,
                    40,
                    70
                ],
                "fitMode": "contain",
                "defaultPrompt": "semiconductor fabrication process diagram schematic blue styling"
            }
        ]
    },
    "style": {
        "fontFamily": "Inter",
        "backgroundColor": "#F0F4F8"
    }
}