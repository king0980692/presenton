{
    "templateName": "tech-innovator",
    "layoutId": "content-split",
    "layoutName": "Tech Content Split",
    "layoutDescription": "Content page with text and image side-by-side.",
    "structure": {
        "type": "absolute",
        "elements": [
            {
                "type": "heading",
                "field": "section_title",
                "bounds": [
                    5,
                    5,
                    90,
                    10
                ],
                "align": "left",
                "level": 2,
                "zIndex": 10
            },
            {
                "type": "text",
                "field": "main_content",
                "bounds": [
                    5,
                    20,
                    45,
                    70
                ],
                "zIndex": 10,
                "maxWords": 100
            },
            {
                "type": "image",
                "field": "content_image",
                "bounds": [
                    55,
                    20,
                    40,
                    70
                ],
                "fitMode": "cover",
                "zIndex": 10,
                "defaultPrompt": "modern semiconductor lab clean room"
            },
            {
                "type": "image",
                "field": "tech_accent",
                "bounds": [
                    0,
                    95,
                    100,
                    5
                ],
                "fitMode": "cover",
                "zIndex": 0,
                "defaultPrompt": "red led light strip"
            }
        ]
    },
    "style": {
        "fontFamily": "Inter",
        "backgroundColor": "#FFFFFF"
    }
}