{
    "templateName": "modern-minimalist",
    "layoutId": "minimal-stats",
    "layoutName": "2. Big Data Impact",
    "layoutDescription": "Large numbers layout without frames.",
    "structure": {
        "type": "absolute",
        "background": "#F5F5F5",
        "elements": [
            {
                "type": "heading",
                "field": "stat_title",
                "bounds": [
                    10,
                    10,
                    80,
                    10
                ],
                "level": 2,
                "align": "left",
                "zIndex": 10,
                "defaultValue": "IMPACT BY NUMBERS"
            },
            {
                "type": "metrics",
                "field": "metrics_list",
                "bounds": [
                    10,
                    30,
                    80,
                    50
                ],
                "zIndex": 10,
                "max": 3,
                "direction": "horizontal",
                "defaultValue": [
                    {
                        "value": "100%",
                        "label": "RENEWABLE",
                        "description": "Global energy usage"
                    },
                    {
                        "value": "0",
                        "label": "WASTE",
                        "description": "To landfill since 2020"
                    },
                    {
                        "value": "5M",
                        "label": "PLANTED",
                        "description": "Trees in urban areas"
                    }
                ]
            }
        ]
    }
}